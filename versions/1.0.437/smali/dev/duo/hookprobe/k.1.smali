.class final Ldev/duo/hookprobe/k;
.super Ljava/lang/Object;
.source "SourceFile"


# static fields
.field static final a:Ljava/lang/String; = "MY=$$\nsnap() {\n  echo \"=== \u72b6\u6001\u5feb\u7167\uff1a$1\uff08$(date \'+%F %T\')\uff09===\"\n  echo \"--- \u8fdb\u7a0b\u4e0e MiDuo \u52a0\u8f7d\u6838\u5bf9\uff08\u8f7d\u5165\u5305\u5e94\u7b49\u4e8e pm path\uff09\"\n  echo \"pm path: $(pm path dev.duo.hookprobe | head -1)\"\n  for p in com.miui.home com.android.systemui system_server com.miui.personalassistant com.android.quicksearchbox dev.duo.hookprobe MiDuoFoldEngine; do\n    pid=$(pidof $p | cut -d\' \' -f1)\n    if [ -z \"$pid\" ]; then echo \"$p: \u672a\u8fd0\u884c\"; continue; fi\n    up=$(ps -A -o PID,ETIME | while read a b; do [ \"$a\" = \"$pid\" ] && echo $b; done)\n    apk=$(grep -m1 -o \'/data/app/[^ ]*dev.duo.hookprobe[^ ]*base.apk\' /proc/$pid/maps 2>/dev/null)\n    echo \"$p: pid=$pid \u5df2\u8fd0\u884c=$up \u8f7d\u5165\u5305=${apk:-\u65e0\u6620\u5c04}\"\n  done\n  echo \"--- \u7a97\u53e3\u4e0e\u6298\u53e0\u72b6\u6001\"\n  timeout 4 dumpsys window displays | head -c 60000\n  timeout 3 dumpsys device_state | head -c 6000\n  echo \"--- \u663e\u793a\u53c2\u6570\"\n  timeout 3 dumpsys display | grep -E \"DisplayDeviceInfo|mBaseDisplayInfo\" | cut -c1-220 | head -6\n  echo \"--- \u4efb\u52a1\u4e0e\u7a97\u53e3\u6a21\u5f0f\uff08\u5de5\u4f5c\u53f0/\u5206\u5c4f\u6210\u5458\uff09\"\n  timeout 5 dumpsys activity activities | grep -E \"topResumedActivity|mResumedActivity|Task\\{\" | cut -c1-220 | head -80\n  echo \"--- \u56fe\u5c42\uff08MiDuo / \u6b8b\u7559\u56fe\u5c42\uff09\"\n  timeout 4 dumpsys SurfaceFlinger --list | grep -E \"Duo|MiDuo|FloatingIcon|transition-leash|Task=|Bubbles\" | cut -c1-200 | head -80\n  echo \"\u56fe\u5c42\u603b\u6570=$(timeout 4 dumpsys SurfaceFlinger --list | wc -l)\"\n  echo \"--- \u5c0f\u7ec4\u4ef6\uff08MiDuo / \u76f8\u518c\u63d0\u4f9b\u65b9\uff09\"\n  timeout 5 dumpsys appwidget | grep -E -i \"hookprobe|com.miui.gallery|Provider\\{|appWidgetId\" | cut -c1-200 | head -60\n  echo \"--- \u6743\u9650\u4e0e\u7cfb\u7edf\u72b6\u6001\"\n  appops get dev.duo.hookprobe 10017 2>&1 | head -2\n  appops get dev.duo.hookprobe 10020 2>&1 | head -2\n  getprop | grep -E \"debug\\.duo|persist\\.duo|ro\\.build\\.version\\.incremental|ro\\.miui\\.ui\\.version\" | head -20\n  echo \"uptime=$(uptime)\"\n  echo \"boot_id=$(cat /proc/sys/kernel/random/boot_id)\"\n  dumpsys battery | grep -E \"level|temperature|status\" | head -4\n  echo \"--- \u5185\u5b58\uff08PSS\uff0c\u770b\u6cc4\u6f0f\uff09\"\n  for p in com.miui.home com.android.systemui dev.duo.hookprobe; do\n    echo \"[$p]\"\n    timeout 4 dumpsys meminfo $p 2>/dev/null | grep -E \"TOTAL PSS|TOTAL:|Java Heap|Native Heap\" | head -3\n  done\n  echo \"--- \u5d29\u6e83/ANR/\u5893\u7891\u8bb0\u5f55\uff08dropbox \u6761\u76ee\uff1a\u65f6\u95f4 \u7c7b\u578b\uff09\"\n  timeout 5 dumpsys dropbox 2>/dev/null | grep -E \"crash|anr|tombstone|wtf\" | grep -v \"Low priority\" | tail -30 | cut -c1-120\n  echo \"--- \u6700\u8fd1\u5d29\u6e83/ANR \u7684\u8fdb\u7a0b\u4e0e\u4e3b\u9898\uff08dropbox \u5185\u5bb9\uff09\"\n  timeout 6 dumpsys dropbox --print 2>/dev/null | grep -E \"^(Process|Subject):\" | tail -20 | cut -c1-160\n}\necho \"=== \u62a5\u544a\u76ee\u5f55\uff1a\u5f00\u5934\u72b6\u6001\u5feb\u7167 / \u5e38\u9a7b\u8bb0\u5f55\uff08\u6700\u8fd1\uff09 / \u590d\u73b0\u671f\u95f4\u65e5\u5fd7 / \u7ed3\u5c3e\u72b6\u6001\u5feb\u7167 ===\"\nsnap \u5f00\u5934\necho \"=== \u5e38\u9a7b\u8bb0\u5f55\uff08\u6700\u8fd1\uff0c\u53ef\u80fd\u4e3a\u7a7a\uff09 ===\"\nls -tr /data/local/tmp/miduo-ring/ring.* 2>/dev/null | head -4 | while read f; do cat \"$f\"; done | tail -c 4194304\necho \"=== \u590d\u73b0\u671f\u95f4\u65e5\u5fd7\uff08\u6240\u6709 Duo*/MiDuo*/TaskCore* \u6807\u7b7e + \u6240\u6709\u8b66\u544a\u9519\u8bef + \u7cfb\u7edf\u5173\u952e I \u7ea7\uff09 ===\"\n# 422: logd \u4f1a\u6390\u6389\u8bfb\u5f97\u6162\u7684 logcat\uff08\u62a5 Unexpected EOF\uff09\u3002\u65ad\u4e86\u5c31\u4ece\u4e2d\u65ad\u524d 5 \u79d2\u91cd\u63a5\uff08\u53ef\u80fd\u5c11\u91cf\u91cd\u590d\uff09\uff0c\u76f4\u5230\u7528\u6237\u7ed3\u675f\uff1b\n# \u7ed3\u675f\u5148\u7acb\u505c\u6b62\u6807\u8bb0\u518d\u505c logcat\uff08logcat \u662f\u5faa\u73af\u5b50 shell \u7684\u5b50\u8fdb\u7a0b\uff0c\u6309\u7236\u8fdb\u7a0b\u627e\uff0c\u4e0d\u6309\u547d\u4ee4\u884c\u627e\uff0c\u514d\u5f97\u8bef\u6740\u5e38\u9a7b\u8bb0\u5f55\uff09\u3002\nSTOP=/data/local/tmp/miduo-ring-live-stop.$MY\nrm -f \"$STOP\"\n(\n  t=\n  while [ ! -e \"$STOP\" ]; do\n    if [ -z \"$t\" ]; then logcat -b main -b system -b crash -b events -v threadtime -T 1; else logcat -b main -b system -b crash -b events -v threadtime -T \"$t.000\"; fi\n    [ -e \"$STOP\" ] && break\n    t=$(( $(date +%s) - 5 ))\n    echo \"=== \u65e5\u5fd7\u8bfb\u53d6\u88ab\u7cfb\u7edf\u4e2d\u65ad\uff08$(date \'+%T\')\uff09\uff0c\u5df2\u81ea\u52a8\u91cd\u63a5\uff1a\u4ece\u4e2d\u65ad\u524d 5 \u79d2\u8865\u8d77\uff0c\u53ef\u80fd\u6709\u5c11\u91cf\u91cd\u590d ===\" >&2\n    sleep 1\n  done\n) | grep --line-buffered -E \"^[0-9-]+ +[0-9:.]+ +[0-9]+ +[0-9]+ ([VDIWEF] (Duo|MiDuo|TaskCore)[A-Za-z0-9_]* *:|[WEF] |I (ActivityTaskManager|ActivityManager|WindowManager|AppWidgetServiceImpl|PackageManager|DEBUG|am_anr|am_crash|am_proc_start|am_kill|wm_activity_launch_time) *:)\" &\ncapture_pid=$!\nend_logcat() { touch \"$STOP\"; for p in $(pgrep -P $MY); do pkill -P \"$p\" logcat 2>/dev/null; done; }\nexec 3<&0\n(read -r capture_stop <&3; end_logcat) &\nstop_pid=$!\ntrap \'kill \"$stop_pid\" 2>/dev/null; end_logcat; wait 2>/dev/null; rm -f \"$STOP\"\' EXIT\nwait \"$capture_pid\"\necho \"=== \u590d\u73b0\u7ed3\u675f ===\"\nsnap \u7ed3\u5c3e\n"

.field static final b:Ljava/lang/String; = "[ \"$(id -u)\" = 0 ] || { echo NOT_ROOT; exit 1; }\nD=/data/local/tmp/miduo-ring\nmkdir -p \"$D\" && chmod 700 \"$D\"\nif pgrep -f \'miduo-ring/ring[.]sh\' >/dev/null; then echo RING_ALREADY; exit 0; fi\ncat > \"$D/ring.sh\" <<\'EOS\'\nD=/data/local/tmp/miduo-ring\n# 422: logcat \u88ab logd \u6390\u65ad\u540e\u4ece\u4e2d\u65ad\u524d 5 \u79d2\u91cd\u63a5\uff0c\u5e38\u9a7b\u8bb0\u5f55\u4e0d\u518d\u5c31\u6b64\u505c\u6389\uff08\u505c\u6b62\u65f6\u6574\u7ec4\u7ed3\u675f\uff09\u3002\nt=\nwhile :; do\n  if [ -z \"$t\" ]; then logcat -b main -b system -b crash -b events -v threadtime -T 1; else logcat -b main -b system -b crash -b events -v threadtime -T \"$t.000\"; fi\n  t=$(( $(date +%s) - 5 ))\n  sleep 1\ndone | grep --line-buffered -E \"^[0-9-]+ +[0-9:.]+ +[0-9]+ +[0-9]+ ([VDIWEF] (Duo|MiDuo|TaskCore)[A-Za-z0-9_]* *:|[EF] (AndroidRuntime|DEBUG|libc|ActivityManager|ActivityTaskManager|WindowManager|AppWidgetServiceImpl) *:|I (ActivityTaskManager|ActivityManager|WindowManager|AppWidgetServiceImpl|PackageManager|DEBUG|am_anr|am_crash|am_proc_start|am_kill|wm_activity_launch_time) *:)\" | {\n  i=0\n  while :; do\n    f=\"$D/ring.$((i % 4))\"\n    head -c 2097152 > \"$f\"\n    [ -s \"$f\" ] || break\n    i=$((i + 1))\n  done\n}\nEOS\nsetsid sh \"$D/ring.sh\" </dev/null >/dev/null 2>&1 &\nsleep 1\nif pgrep -f \'miduo-ring/ring[.]sh\' >/dev/null; then echo RING_STARTED; else echo RING_FAILED; fi\n"

.field static final c:Ljava/lang/String; = "[ \"$(id -u)\" = 0 ] || { echo NOT_ROOT; exit 1; }\n# fix412 F2: find the recorder only by its own script name (the [.] keeps this script\'s command line from matching) and end\n# its whole process group (logcat, grep, writer). Matching the logcat command line used to hit the sh -c running this very\n# script, so the folder was never deleted, and it also killed a bug report capture in progress.\nfor p in $(pgrep -f \'miduo-ring/ring[.]sh\'); do\n  g=$(cut -d\' \' -f5 \"/proc/$p/stat\" 2>/dev/null)\n  if [ \"$g\" = \"$p\" ]; then kill -TERM -\"$p\" 2>/dev/null; else kill -TERM \"$p\" 2>/dev/null; fi\ndone\ni=0\nwhile pgrep -f \'miduo-ring/ring[.]sh\' >/dev/null && [ \"$i\" -lt 30 ]; do sleep 0.1; i=$((i + 1)); done\nif pgrep -f \'miduo-ring/ring[.]sh\' >/dev/null; then echo RING_STOP_FAILED; exit 1; fi\nrm -rf /data/local/tmp/miduo-ring\n[ -e /data/local/tmp/miduo-ring ] && { echo RING_STOP_FAILED; exit 1; }\necho RING_STOPPED\n"

.field static final d:Ljava/lang/String; = "^[0-9-]+ +[0-9:.]+ +[0-9]+ +[0-9]+ ([VDIWEF] (Duo|MiDuo|TaskCore)[A-Za-z0-9_]* *:|[WEF] |I (ActivityTaskManager|ActivityManager|WindowManager|AppWidgetServiceImpl|PackageManager|DEBUG|am_anr|am_crash|am_proc_start|am_kill|wm_activity_launch_time) *:)"

.field static final e:Ljava/lang/String; = "^[0-9-]+ +[0-9:.]+ +[0-9]+ +[0-9]+ ([VDIWEF] (Duo|MiDuo|TaskCore)[A-Za-z0-9_]* *:|[EF] (AndroidRuntime|DEBUG|libc|ActivityManager|ActivityTaskManager|WindowManager|AppWidgetServiceImpl) *:|I (ActivityTaskManager|ActivityManager|WindowManager|AppWidgetServiceImpl|PackageManager|DEBUG|am_anr|am_crash|am_proc_start|am_kill|wm_activity_launch_time) *:)"


